# Optional: Langfuse tracing for the generated CUGA implementation
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Migration scripts (migrate.sh / cuga_sync.sh / source_sync.sh) ─────────────
# Required — API key / auth token for the Claude Code CLI
ANTHROPIC_AUTH_TOKEN=sk-...

# Required — model ID passed to Claude Code
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — API endpoint (omit to use the default Anthropic API; set for proxies like LiteLLM)
# ANTHROPIC_BASE_URL=https://your-litellm-endpoint

# Optional — disable experimental betas (set to 1 if your proxy doesn't support them)
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
